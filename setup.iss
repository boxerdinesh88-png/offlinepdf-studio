; Inno Setup script for OfflinePDF Studio
; Compiled by build_installer.bat, which sets the OFFLINEPDF_* environment
; variables (paths may contain spaces).

#define BuildRoot GetEnv("OFFLINEPDF_BUILD")
#if GetEnv("OFFLINEPDF_ICON") != ""
  #define IconFile GetEnv("OFFLINEPDF_ICON")
#endif
#define AppVersion GetEnv("OFFLINEPDF_VERSION")
#define OutputDir GetEnv("OFFLINEPDF_OUTPUT")
#define SourceDir BuildRoot + "\dist\OfflinePDFStudio"

#define AppName "OfflinePDF Studio"
#define AppExeName "OfflinePDF Studio.exe"
#define AppPublisher "Dinesh Kumar"
; Per-user data folder used by offlinepdf.config.data_dir().
#define AppDataFolder "{localappdata}\OfflinePDF Studio"
; Fixed application identity - never change this value across releases.
#define AppId "{{9F2D6B34-7A1C-4E58-9B3D-2C6A1F0E4D7B}"

[Setup]
AppId={#AppId}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppComments=Fully offline PDF editor
VersionInfoVersion={#AppVersion}
VersionInfoProductName={#AppName}
VersionInfoDescription={#AppName} Setup
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
; Installs per user without admin rights by default; the user may choose
; "all users" in the first dialog, which triggers a UAC elevation prompt.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
WizardStyle=modern
Compression=lzma2/max
SolidCompression=yes
LZMANumBlockThreads=4
OutputDir={#OutputDir}
OutputBaseFilename={#AppName}-Setup-{#AppVersion}
#ifdef IconFile
SetupIconFile={#IconFile}
#endif
; Artwork generated by scripts\make_icon.py; Inno picks the size closest to the current DPI.
WizardImageFile=assets\installer\wizard-164x314.bmp,assets\installer\wizard-246x471.bmp,assets\installer\wizard-328x628.bmp
WizardSmallImageFile=assets\installer\small-55.bmp,assets\installer\small-83.bmp,assets\installer\small-110.bmp
UninstallDisplayIcon={app}\{#AppExeName}
UninstallDisplayName={#AppName}
; Close a running copy (Restart Manager) before files are replaced.
CloseApplications=yes
RestartApplications=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: checkedonce

[InstallDelete]
; Remove files of the previous build so stale DLLs never mix with new ones.
Type: filesandordirs; Name: "{app}\_internal"

[Files]
Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "THIRD_PARTY_LICENSES.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "README.md"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{userdocs}"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{userdocs}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExeName}"; Description: "{cm:LaunchProgram,{#AppName}}"; WorkingDir: "{userdocs}"; Flags: nowait postinstall skipifsilent

[Code]
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
begin
  { User PDFs are never touched.  Settings, logs and crash-recovery files
    live outside the install folder and are kept unless the user opts in. }
  if CurUninstallStep = usPostUninstall then
  begin
    DataDir := ExpandConstant('{#AppDataFolder}');
    if DirExists(DataDir) and not UninstallSilent() then
      if MsgBox('Also delete your OfflinePDF Studio settings, logs and crash-recovery files?' + #13#10#13#10 +
                DataDir + #13#10#13#10 +
                'Your PDF documents are not affected either way.',
                mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
        DelTree(DataDir, True, True, True);
  end;
end;
